# Core runtime. Docker Compose supplies a local database URL if this is empty.
TWIN_STUDIO_DATABASE_URL=
TWIN_STUDIO_DATABASE_POOL_SIZE=12
TWIN_STUDIO_DATABASE_CONNECT_TIMEOUT_MS=15000
TWIN_STUDIO_AUTH_SECRET=<generate-a-long-random-secret>
TWIN_STUDIO_ADMIN_EMAILS=
NEXT_PUBLIC_TINYMCE_API_KEY=

# Email defaults to console output. Configure SMTP only in protected runtime
# configuration; do not commit credentials.
TWIN_STUDIO_EMAIL_MODE=console
TWIN_STUDIO_SMTP_HOST=
TWIN_STUDIO_SMTP_PORT=587
TWIN_STUDIO_SMTP_SECURE=false
TWIN_STUDIO_SMTP_USER=
TWIN_STUDIO_SMTP_PASSWORD=
TWIN_STUDIO_EMAIL_FROM=noreply@example.org
TWIN_STUDIO_EMAIL_FROM_NAME=Open Local Digital Twin
TWIN_STUDIO_EMAIL_REPLY_TO=

# Development/smoke account. Replace before running a shared environment.
TWIN_STUDIO_SMOKE_EMAIL=smoke@example.org
TWIN_STUDIO_SMOKE_PASSWORD=<set-local-smoke-password>
TWIN_STUDIO_SMOKE_CITY_ID=demo-city
TWIN_STUDIO_SMOKE_BASE_URL=http://127.0.0.1:4192

# Optional generic OIDC provider. Additional providers are configured as
# protected runtime profiles from the OLDT operator surface.
OIDC_ENABLED=false
OIDC_PROVIDER_KEY=organization
OIDC_PROVIDER_NAME=Organization login
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4192/api/auth/oidc/organization/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:4192/auth/login
OIDC_SCOPES=openid profile email
OIDC_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_post
OIDC_DEFAULT_CITY_ID=demo-city
OIDC_DEFAULT_ROLE=viewer

# Optional EU LDT fallback endpoints. Multi-instance operation should use the
# profile registry instead of hardcoding URLs in source.
EU_LDT_DATA_PLATFORM_URL=
EU_LDT_PLAY_VISUALISE_DATABASE_URL=
EU_LDT_CIP_MIN_REQUEST_INTERVAL_MS=250

# Optional compatibility fallback.
EMAIL_HOST_PASSWORD=
